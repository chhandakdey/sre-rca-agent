# Azure OpenAI / Azure Foundry Configuration
AZURE_OPENAI_ENDPOINT=https://your-foundry-endpoint.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-1-nano
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure MCP Configuration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Azure DevOps Configuration
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PAT=your-personal-access-token

# App Insights Configuration
APP_INSIGHTS_WORKSPACE_ID=your-workspace-id

# GitHub MCP Configuration
GITHUB_TOKEN=your-github-token
GITHUB_ORG=your-github-org
GITHUB_REPO=your-github-repo

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Correlation Engine Configuration
CORRELATION_TIME_WINDOW_HOURS=24
CORRELATION_MAX_RESULTS=10
ENABLE_ML_CORRELATION=true

# MCP Server URLs (if using external MCP servers)
AZURE_MCP_SERVER_URL=http://localhost:3001
GITHUB_MCP_SERVER_URL=http://localhost:3002
